{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "shared:build": "tsc --build ../shared",
    "dev": "npm run shared:build && vite",
    "build": "npm run shared:build && run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "npm run shared:build && vite build",
    "type-check": "vue-tsc --build",
    "lint": "npm run shared:build && eslint",
    "lint:fix": "npm run shared:build && eslint . --fix"
  },
  "dependencies": {
    "@tm-trialmaple/shared": "file:../shared",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "canvas-confetti": "^1.9.4",
    "dayjs": "^1.11.23",
    "jwt-decode": "^4.0.0",
    "moderndash": "^4.0.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "10.10.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-svg-loader": "^5.1.3",
    "vue-tsc": "^3.3.11"
  }
}
